# Copy to .env.local and fill in. All values are public (NEXT_PUBLIC_*) because the site is a static export.
# Leave a value empty to disable that feature — nothing renders if an ID is missing.

# Canonical site URL (used for metadata + JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.indoxenergy.com

# PLACEHOLDER — client to confirm WhatsApp business number (digits only, with country code, e.g. 919XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Web3Forms access key (used by components/forms/formSubmit.ts in Phase 2)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Analytics — loaded only after the visitor accepts the cookie notice
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
